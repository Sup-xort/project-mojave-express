# 서버
PORT=3000
NODE_ENV=production
DB_PATH=./data/app.db

# 배포 시 HTTPS 뒤에 있으므로 반드시 true. 로컬(http)에서 쿠키 테스트가 필요하면 false.
COOKIE_SECURE=true

# Caddy 등 리버스 프록시 홉 수. 프록시 1개 뒤에 있으면 1.
TRUST_PROXY_HOPS=1

# 매장 시간대 — 리워드 시간대 판정 기준 (plan.md 5.2)
STORE_TZ=Asia/Seoul

# QR
QR_TTL_SEC=120
QR_AMOUNT_MAX=10

# 쿠폰 1장으로 바꾸는 데 필요한 스탬프 수. 이만큼 모이면 자동으로 쿠폰이 발급된다.
COUPON_STAMP_COST=10

# 세션 (1년, 슬라이딩). 손님/사장님 세션 모두 이 값을 쓴다.
SESSION_TTL_SEC=31536000

# 로그인 보호 (손님/사장님 공용)
LOCK_THRESHOLD=5
LOCK_DURATION_SEC=900
IP_ATTEMPT_MAX=20
IP_ATTEMPT_WINDOW_SEC=600

# 쿠폰 사용 요청 만료. 이 시간 안에 사장님이 승인하지 않으면 쿠폰은 다시 미사용으로 돌아온다.
REDEMPTION_TTL_SEC=600

# PIN 해시에 붙는 서버 시크릿. DB에는 절대 저장하지 않음 — 반드시 긴 랜덤 문자열로 교체할 것.
PIN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 사장님 비밀번호 해시에 붙는 서버 시크릿. DB에는 절대 저장하지 않음 — 반드시 긴 랜덤 문자열로 교체할 것.
OWNER_PASSWORD_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_STRING
