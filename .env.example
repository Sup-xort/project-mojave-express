# 서버
PORT=3000
NODE_ENV=production
DB_PATH=./data/app.db

# 배포 시 HTTPS 뒤에 있으므로 반드시 true. 로컬(http)에서 쿠키 테스트가 필요하면 false.
COOKIE_SECURE=true

# Caddy 등 리버스 프록시 홉 수. 프록시 1개 뒤에 있으면 1.
TRUST_PROXY_HOPS=1

# 매장 시간대 — 리워드 시간대 판정 기준 (plan.md 5.2)
STORE_TZ=Asia/Seoul

# QR
QR_TTL_SEC=120
QR_AMOUNT_MAX=10

# 세션 (1년, 슬라이딩)
SESSION_TTL_SEC=31536000

# 로그인 보호
LOCK_THRESHOLD=5
LOCK_DURATION_SEC=900
IP_ATTEMPT_MAX=20
IP_ATTEMPT_WINDOW_SEC=600

# 리워드 교환 요청 만료
REDEMPTION_TTL_SEC=600

# PIN 해시에 붙는 서버 시크릿. DB에는 절대 저장하지 않음 — 반드시 긴 랜덤 문자열로 교체할 것.
PIN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 임시 관리자 API 키 (plan.md 범위 밖의 최소 구현용 — 실제 사장님 앱에서 교체될 예정)
ADMIN_KEY=CHANGE_ME_ADMIN_KEY
